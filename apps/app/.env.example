# Authentication & Database
# Better Auth runs on the NestJS API. The app only calls that API.

AUTH_GOOGLE_ID="" # Optional, enables Google sign-in button
AUTH_GOOGLE_SECRET="" # Optional, enables Google sign-in button
AUTH_GITHUB_ID="" # Optional, enables GitHub sign-in button
AUTH_GITHUB_SECRET="" # Optional, enables GitHub sign-in button
AUTH_MICROSOFT_CLIENT_ID="" # Optional, enables Microsoft sign-in button
AUTH_MICROSOFT_CLIENT_SECRET="" # Optional, enables Microsoft sign-in button
# Social sign-in providers are configured on the NestJS API.
# Set to 'true' to explicitly hide a button without touching the API.
APP_DISABLE_GOOGLE_SIGN_IN=
APP_DISABLE_GITHUB_SIGN_IN=
APP_DISABLE_MICROSOFT_SIGN_IN=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comp"
NEXT_PUBLIC_API_URL="http://localhost:3333" # API origin, also used by authClient
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000" # Public app origin for revalidation and links
BETTER_AUTH_URL="http://localhost:3000" # Server-side app origin for revalidation and links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3002"
UNSUBSCRIBE_SECRET="" # Preferred secret for unsubscribe token signing
AUTH_SECRET="" # Legacy fallback for unsubscribe token signing
SECRET_KEY="" # Must match the API SECRET_KEY for internal protected routes

# Upstash
UPSTASH_REDIS_REST_URL="" # Optional, used for rate limiting
UPSTASH_REDIS_REST_TOKEN="" # Optional, used for rate limiting

# OpenAI
OPENAI_API_KEY="" # Required for app to work

# Resend
RESEND_API_KEY="" # For sending emails, app notifications, etc.

# Trigger
TRIGGER_SECRET_KEY="" # Required, for all async jobs and tasks
TRIGGER_PROJECT_ID="" # Trigger.dev project ID (defaults to hardcoded value if unset)

# Posthog
NEXT_PUBLIC_POSTHOG_HOST=/ingest # GTM Trackers
NEXT_PUBLIC_POSTHOG_KEY="" # GTM Trackers

# Vercel
VERCEL_ACCESS_TOKEN="" # For trust portal domains
VERCEL_TEAM_ID="" # For trust portal domains
VERCEL_PROJECT_ID="" # For trust portal domains
NEXT_PUBLIC_VERCEL_URL="" # eg. betayum.com

# Preferred: Google Cloud Storage via S3 interoperability keys
APP_GCP_BUCKET_NAME="" # Default object storage bucket
APP_GCP_QUESTIONNAIRE_UPLOAD_BUCKET="" # Optional, falls back to APP_GCP_BUCKET_NAME
APP_GCP_KNOWLEDGE_BASE_BUCKET="" # Optional, falls back to APP_GCP_BUCKET_NAME
APP_GCP_ORG_ASSETS_BUCKET="" # Optional, falls back to APP_GCP_BUCKET_NAME
APP_GCP_REGION="auto"
APP_GCP_ACCESS_KEY_ID=""
APP_GCP_SECRET_ACCESS_KEY=""
APP_GCP_ENDPOINT="https://storage.googleapis.com"

# Legacy AWS S3 fallback
APP_AWS_BUCKET_NAME=""
APP_AWS_REGION=""
APP_AWS_ACCESS_KEY_ID=""
APP_AWS_SECRET_ACCESS_KEY=""
APP_AWS_ORG_ASSETS_BUCKET=""
APP_AWS_ENDPOINT="" # optional for using services like MinIO

# TRIGGER REVAL
REVALIDATION_SECRET="" # Revalidate server side, generate something random

GROQ_API_KEY="" # For the AI chat, on dashboard
ANTHROPIC_API_KEY="" # Optional, For more options with models

NEXT_OUTPUT_STANDALONE=false # For deploying on AWS instead of Vercel

FLEET_URL="" # If you want to enable MDM, your hosted url
FLEET_TOKEN="" # If you want to enable MDM

FIRECRAWL_API_KEY="" # To research vendors, Required

NOVU_API_KEY=
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # Stripe publishable key for browser Stripe.js usage (pk_live_... or pk_test_...)

# Service token for Trigger.dev tasks calling the NestJS API
SERVICE_TOKEN_TRIGGER= # Must match API's SERVICE_TOKEN_TRIGGER

# Internal API Authentication
INTERNAL_API_TOKEN= # Shared secret for internal API calls (must match API's)
