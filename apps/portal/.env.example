# Authentication
# Better Auth runs on the NestJS API. The portal only calls that API.
BETTER_AUTH_URL="http://localhost:3002" # Public portal origin used in portal links
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:3333"
BACKEND_API_URL="http://localhost:3333"
AUTH_GOOGLE_ID="" # Optional, enables Google sign-in button
AUTH_GOOGLE_SECRET="" # Optional, enables Google sign-in button
AUTH_MICROSOFT_CLIENT_ID="" # Optional, enables Microsoft sign-in button
AUTH_MICROSOFT_CLIENT_SECRET="" # Optional, enables Microsoft sign-in button
RESEND_API_KEY="" # https://resend.com/api-keys
RESEND_DOMAIN="" # ex. mail.betayum.com

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comp"

# Preferred: Google Cloud Storage via S3 interoperability keys
APP_GCP_ACCESS_KEY_ID=""
APP_GCP_SECRET_ACCESS_KEY=""
APP_GCP_REGION="auto"
APP_GCP_BUCKET_NAME=""
APP_GCP_ORG_ASSETS_BUCKET=""
APP_GCP_ENDPOINT="https://storage.googleapis.com"

# Legacy AWS S3 fallback
APP_AWS_ACCESS_KEY_ID=""
APP_AWS_SECRET_ACCESS_KEY=""
APP_AWS_REGION=""
APP_AWS_BUCKET_NAME=""
APP_AWS_ENDPOINT="" # optional for using services like MinIO

# API
INTERNAL_API_TOKEN= # Shared secret for internal API calls (must match API's INTERNAL_API_TOKEN)
SERVICE_TOKEN_PORTAL= # Optional service token for server-to-server portal calls

# Device Agent
DEVICE_AGENT_S3_ENV= # 'staging' or 'production' (default: production)
FLEET_AGENT_BUCKET_NAME= # Optional override; falls back to APP_GCP_BUCKET_NAME / APP_AWS_BUCKET_NAME
