BASE_URL="http://localhost:3333" # Better Auth server/API origin
BETTER_AUTH_URL="http://localhost:3000" # App origin used for invite/app links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3002"
SECRET_KEY="" # Better Auth secret used by the API auth server
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comp"
NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem
PORT="3333"

# Social providers configured on the API auth server
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google Cloud Storage via Application Default Credentials.
# Locally: gcloud auth application-default login
# Cloud Run: grant the runtime service account objectAdmin on APP_OBJECT_STORAGE_BUCKET
# and objectViewer on APP_DEVICE_AGENT_ARTIFACTS_BUCKET.
APP_OBJECT_STORAGE_BUCKET=
APP_GCP_QUESTIONNAIRE_UPLOAD_BUCKET= # Optional; falls back to APP_OBJECT_STORAGE_BUCKET
APP_GCP_KNOWLEDGE_BASE_BUCKET= # Optional; falls back to APP_OBJECT_STORAGE_BUCKET
APP_GCP_ORG_ASSETS_BUCKET= # Optional; falls back to APP_OBJECT_STORAGE_BUCKET
APP_DEVICE_AGENT_ARTIFACTS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS= # Optional local service-account JSON path; prefer ADC when possible

# Microsoft sign-in (Entra ID / Azure AD)
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID= # 'common' (default), 'organizations', or your tenant GUID

NOVU_API_KEY=

# Service tokens for internal service-to-service auth (scoped, per-service)
SERVICE_TOKEN_TRIGGER= # Used by Trigger.dev tasks
SERVICE_TOKEN_PORTAL=  # Used by Portal app

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Trigger
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID= # Trigger.dev project ID

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Resend (for sending emails)
RESEND_API_KEY=
RESEND_FROM_SYSTEM= # e.g., noreply@mail.betayum.com
RESEND_FROM_DEFAULT= # e.g., hello@mail.betayum.com
RESEND_FROM_TRUST_PORTAL= # e.g., Betayum <noreply@mail.trust.inc> — sender for Trust Portal access/NDA emails (falls back to RESEND_FROM_SYSTEM)

# Background checks
BACKGROUND_CHECK_API_BASE_URL=https://glad-sturgeon-729.convex.site
BACKGROUND_CHECK_API_KEY=
MACED_API_KEY=mc_dev_dummy_api_key
BACKGROUND_CHECK_WEBHOOK_SECRET=
BACKGROUND_WH_ENDPOINT=
STRIPE_BACKGROUND_CHECK_PRICE_ID=price_1TRWckCkFWhKYvHIA1GLv1sO
STRIPE_SECRET_KEY= # Stripe secret key (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET= # Stripe webhook signing secret (whsec_...)

# We are not using security hub service it is only the variable prefix for matching with old one
SECURITY_HUB_ROLE_ASSUMER_ARN=
SECURITY_HUB_GOVCLOUD_ROLE_ASSUMER_ARN=
SECURITY_HUB_GOVCLOUD_ACCESS_KEY_ID=
SECURITY_HUB_GOVCLOUD_SECRET_ACCESS_KEY=
# Optional: only set when using temporary GovCloud credentials. Leave unset for long-lived IAM user keys.
# SECURITY_HUB_GOVCLOUD_SESSION_TOKEN=
