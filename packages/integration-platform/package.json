{
  "name": "@trycompai/integration-platform",
  "version": "1.0.0",
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.948.0",
    "@aws-sdk/client-iam": "^3.948.0",
    "@aws-sdk/client-securityhub": "^3.948.0",
    "@aws-sdk/client-sts": "^3.948.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "generate:tasks": "bun run scripts/generate-task-types.ts",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "bun run src/validators/manifest-validator.ts"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts"
}
