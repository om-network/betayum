{
  "name": "@trycompai/utils",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./devices": {
      "types": "./dist/devices.d.ts",
      "import": "./dist/devices.mjs",
      "require": "./dist/devices.js"
    },
    "./envs": {
      "types": "./dist/envs.d.ts",
      "import": "./dist/envs.mjs",
      "require": "./dist/envs.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.mjs",
      "require": "./dist/brand.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.mjs",
      "require": "./dist/format.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts src/brand.ts src/devices.ts src/envs.ts src/format.ts --format cjs,esm --dts",
    "clean": "rm -rf .turbo node_modules",
    "dev": "tsup src/index.ts src/devices.ts src/envs.ts src/format.ts --format cjs,esm --dts --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false
}
