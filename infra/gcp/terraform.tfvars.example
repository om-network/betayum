repository = {
  owner = "om-network"
  name  = "betayum"
}

environments = {
  staging = {
    project_id        = "betayum-staging-project-id"
    region            = "us-central1"
    branch_name       = "develop"
    approval_required = false
    cloud_sql_instance_connection_name = "staging-project-id:us-central1:betayum-db"
    app_data_bucket_name               = "betayum-staging-app-data"
    device_agent_artifacts_bucket_name = "betayum-staging-device-agent-artifacts"
    trigger_domain                     = "trigger.34-8-88-115.sslip.io"
    trigger_machine_type               = "e2-standard-4"

    domains = {
      api    = "api.staging.betayum.com"
      app    = "app.staging.betayum.com"
      portal = "portal.staging.betayum.com"
    }
  }

  production = {
    project_id        = "betayum-prod-project-id"
    region            = "us-central1"
    branch_name       = "release"
    approval_required = true
    cloud_sql_instance_connection_name = "prod-project-id:us-central1:betayum-db"
    app_data_bucket_name               = "betayum-production-app-data"
    device_agent_artifacts_bucket_name = "betayum-production-device-agent-artifacts"
    trigger_domain                     = "trigger.betayum.com"
    trigger_machine_type               = "e2-standard-4"

    domains = {
      api    = "api.betayum.com"
      app    = "app.betayum.com"
      portal = "portal.betayum.com"
    }
  }
}
